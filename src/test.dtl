DTL<4096> kernel_d = {
    for (int i = 0; i < 1000; i++) {
        out = i;
    }
}

DTL<4096> kernel_c  : kernel_d = {
    metadata_stream<4, kernel_d> kd;
    for (int i = 0; i < 1000; i++) {
        out = kd[i];
    }
}

DTL<4096> kernel_a : kernel_c = {
    metadata_stream<4, kernel_c> kc;
    for (int i = 0; i < 1000; i++) {
        out = kc[i];
    }
}

DTL<4096> kernel_b = {
    for (int i = 0; i < 1000; i++) {
        out = i;
    }
}

DTL<4096> kernel: kernel_a, kernel_b = {
    metadata_stream<4, kernel_a> kc;
    for (int i = 0; i < 1000; i++) {
        for (int j = 0; j < 10; j++)
        {
            if (i > j)
            {
                out = 1;
            }
            else
            {
                out = i;
            }
        }
    }
}

active kernel;
